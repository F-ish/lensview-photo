[Unit]
Description=LensView Photo Community
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/.openclaw/workspace/lensview
ExecStart=/root/.nvm/versions/node/v22.22.0/bin/node server.js
Restart=always
RestartSec=10
StandardOutput=append:/root/.openclaw/workspace/lensview/lensview.log
StandardError=append:/root/.openclaw/workspace/lensview/lensview.error.log
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
