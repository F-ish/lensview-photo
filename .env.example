# 管理员账号配置
# 运行 node init-admin.js 来设置密码

# 管理员用户名
ADMIN_USERNAME=admin

# 管理员密码哈希（通过 init-admin.js 生成）
ADMIN_PASSWORD_HASH=

# JWT 密钥（请修改为随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# 服务配置
PORT=3000
HOST=127.0.0.1

# 允许访问的域名（CORS）
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
